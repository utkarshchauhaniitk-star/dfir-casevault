# DFIR CaseVault Environment Configuration
PROJECT_NAME="DFIR CaseVault"
ENVIRONMENT="development"
DEBUG=true

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="sqlite:///./dfir_casevault.db"
# Production example: DATABASE_URL="postgresql://user:password@localhost:5432/casevault"

# Storage
EVIDENCE_STORAGE_DIR="./evidence_storage"
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB

# Security & CORS
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
DEMO_ACTOR_NAME="Lead Forensic Investigator (Demo)"
DEMO_ACTOR_EMAIL="investigator@casevault.local"
SECRET_KEY="replace-with-a-secure-random-secret-in-production"
